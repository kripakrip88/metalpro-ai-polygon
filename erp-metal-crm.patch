+<style>
+:root{--bg:#f4f5f7;--surface:#fff;--border:#e2e5ea;--border2:#c8cdd6;--text:#1a1d23;--muted:#6b7280;--accent:#2563eb;--accent-h:#1d4ed8;--green:#16a34a;--red:#dc2626;--yellow:#d97706;--purple:#7c3aed;}
+*{margin:0;padding:0;box-sizing:border-box;}
+body{font-family:'Manrope',sans-serif;font-size:13px;background:var(--bg);color:var(--text);line-height:1.5;}
+.shell{display:flex;min-height:100vh;}
+.sidebar{width:204px;background:var(--surface);border-right:1px solid var(--border);flex-shrink:0;position:fixed;top:0;left:0;bottom:0;display:flex;flex-direction:column;}
+.logo{padding:14px 16px;border-bottom:1px solid var(--border);font-weight:800;font-size:14px;color:var(--accent);}
+.logo span{display:block;font-size:10px;font-weight:500;color:var(--muted);margin-top:2px;}
+nav{padding:8px;flex:1;}
+.nav-group{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted);padding:10px 8px 4px;}
+.nav-item{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:6px;cursor:pointer;color:var(--muted);font-weight:500;font-size:12.5px;transition:all .1s;margin-bottom:1px;text-decoration:none;}
+.nav-item:hover{background:var(--bg);color:var(--text);}
+.nav-item.active{background:#eff6ff;color:var(--accent);font-weight:600;}
+.sidebar-bottom{padding:12px;border-top:1px solid var(--border);font-size:11px;color:var(--muted);}
+.main{margin-left:204px;flex:1;}
+.topbar{height:48px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 20px;gap:12px;position:sticky;top:0;z-index:20;}
+.topbar-title{font-weight:700;font-size:14px;}
+.topbar-right{margin-left:auto;display:flex;gap:8px;align-items:center;}
+.content{padding:20px;}
+.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:6px;border:none;cursor:pointer;font-family:'Manrope';font-size:12.5px;font-weight:600;transition:all .12s;white-space:nowrap;}
+.btn-primary{background:var(--accent);color:#fff;}.btn-primary:hover{background:var(--accent-h);}
+.btn-secondary{background:var(--bg);color:var(--text);border:1px solid var(--border2);}.btn-secondary:hover{border-color:var(--accent);color:var(--accent);}
+.btn-sm{padding:4px 10px;font-size:12px;}
+.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
+.controls{display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap;}
+.search-wrap{position:relative;flex:1;min-width:200px;max-width:360px;}
+.search-input{width:100%;height:34px;padding:0 10px 0 30px;background:var(--surface);border:1px solid var(--border2);border-radius:5px;color:var(--text);font-family:'Manrope';font-size:13px;outline:none;transition:border-color .12s;}
+.search-input:focus{border-color:var(--accent);}
+.search-icon{position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none;}
+.count-label{font-size:12px;color:var(--muted);margin-left:auto;}
+table{width:100%;border-collapse:collapse;}
+thead th{padding:8px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);background:#fafbfc;border-bottom:1px solid var(--border);}
+tbody tr{border-bottom:1px solid var(--border);transition:background .1s;cursor:pointer;}
+tbody tr:last-child{border-bottom:none;}
+tbody tr:hover{background:#f8faff;}
+td{padding:9px 12px;vertical-align:middle;}
+.badge{display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;}
+.b-vip{background:#fdf4ff;color:var(--purple);}
+.b-high{background:#eff6ff;color:var(--accent);}
+.b-normal{background:#f0fdf4;color:var(--green);}
+.b-low{background:#fafafa;color:var(--muted);}
+.empty{text-align:center;padding:48px 20px;color:var(--muted);}
+.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:100;display:flex;align-items:center;justify-content:center;padding:20px;}
+.modal{background:var(--surface);border-radius:10px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,.2);}
+.modal-header{padding:16px 20px;border-bottom:1px solid var(--border);font-weight:700;font-size:14px;display:flex;justify-content:space-between;align-items:center;}
+.modal-body{padding:20px;}
+.modal-footer{padding:12px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;}
+.form-group{margin-bottom:14px;}
+.form-label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:4px;}
+.form-input{width:100%;height:34px;padding:0 10px;border:1px solid var(--border2);border-radius:5px;font-family:'Manrope';font-size:13px;color:var(--text);outline:none;background:var(--surface);}
+.form-input:focus{border-color:var(--accent);}
+.form-select{width:100%;height:34px;padding:0 10px;border:1px solid var(--border2);border-radius:5px;font-family:'Manrope';font-size:13px;color:var(--text);background:var(--surface);outline:none;}
+.hidden{display:none!important;}
+</style>
+</head>
+<body>
+<div class="shell">
+  <aside class="sidebar">
+    <div class="logo">МеталлПро ERP <span>Рабочий стенд v1.0</span></div>
+    <nav>
+      <div class="nav-group">Workflow</div>
+      <a class="nav-item" href="orders.html"><span>📋</span> Журнал заказов</a>
+      <a class="nav-item" href="simulator.html"><span>🧮</span> Расчёт КП</a>
+      <div class="nav-group">CRM</div>
+      <a class="nav-item active" href="crm.html"><span>👥</span> Клиенты</a>
+      <a class="nav-item" href="email-inbox.html"><span>📧</span> Входящие письма</a>
+      <div class="nav-group">Справочники</div>
+      <a class="nav-item" href="materials.html"><span>🔩</span> Материалы</a>
+      <a class="nav-item" href="templates.html"><span>📦</span> Шаблоны</a>
+    </nav>
+    <div class="sidebar-bottom">МеталлПро ERP · v1.0</div>
+  </aside>
+
+  <div class="main">
+    <div class="topbar">
+      <div class="topbar-title">Клиенты (CRM)</div>
+      <div class="topbar-right">
+        <button class="btn btn-primary" onclick="openCreateModal()">+ Новый клиент</button>
+      </div>
+    </div>
+
+    <div class="content">
+      <div class="controls">
+        <div class="search-wrap">
+          <span class="search-icon">🔍</span>
+          <input class="search-input" id="searchInput" type="text" placeholder="Поиск по названию..." oninput="onSearch()">
+        </div>
+        <span class="count-label" id="countLabel">Загрузка...</span>
+      </div>
+
+      <div class="card">
+        <table id="customersTable">
+          <thead>
+            <tr>
+              <th>Компания</th>
+              <th>ИНН</th>
+              <th>Email</th>
+              <th>Телефон</th>
+              <th>Заказов</th>
+              <th>Приоритет</th>
+            </tr>
+          </thead>
+          <tbody id="customersBody">
+            <tr><td colspan="6" class="empty"><div class="icon">⏳</div>Загрузка...</td></tr>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+<!-- Create modal -->
+<div class="modal-bg hidden" id="createModal">
+  <div class="modal">
+    <div class="modal-header">
+      Новый клиент
+      <button class="btn btn-sm btn-secondary" onclick="closeCreateModal()">✕</button>
+    </div>
+    <div class="modal-body">
+      <div class="form-group"><label class="form-label">Название *</label><input class="form-input" id="fName" placeholder="ООО Металлторг"></div>
+      <div class="form-group"><label class="form-label">ИНН</label><input class="form-input" id="fInn" placeholder="7700000000"></div>
+      <div class="form-group"><label class="form-label">Email</label><input class="form-input" id="fEmail" type="email" placeholder="info@company.ru"></div>
+      <div class="form-group"><label class="form-label">Телефон</label><input class="form-input" id="fPhone" placeholder="+7 495 000 00 00"></div>
+      <div class="form-group"><label class="form-label">Сайт</label><input class="form-input" id="fWebsite" placeholder="https://company.ru"></div>
+      <div class="form-group"><label class="form-label">Приоритет</label>
+        <select class="form-select" id="fPriority">
+          <option value="NORMAL">Обычный</option>
+          <option value="HIGH">Высокий</option>
+          <option value="VIP">VIP</option>
+          <option value="LOW">Низкий</option>
+        </select>
+      </div>
+    </div>
+    <div class="modal-footer">
+      <button class="btn btn-secondary" onclick="closeCreateModal()">Отмена</button>
+      <button class="btn btn-primary" onclick="createCustomer()">Создать</button>
+    </div>
+  </div>
+</div>
+
+<script>
+const API = '/api'
+let customers = []
+let searchTimer = null
+
+const PRIORITY_LABELS = { VIP: 'VIP', HIGH: 'Высокий', NORMAL: 'Обычный', LOW: 'Низкий' }
+const PRIORITY_CLASSES = { VIP: 'b-vip', HIGH: 'b-high', NORMAL: 'b-normal', LOW: 'b-low' }
+
+async function load(search = '') {
+  const q = search ? `?search=${encodeURIComponent(search)}` : ''
+  const res = await fetch(`${API}/customers${q}`, { headers: authHeaders() })
+  customers = await res.json()
+  render()
+}
+
+function render() {
+  const tbody = document.getElementById('customersBody')
+  document.getElementById('countLabel').textContent = `${customers.length} клиентов`
+  if (!customers.length) {
+    tbody.innerHTML = '<tr><td colspan="6" class="empty"><div class="icon">👥</div>Клиенты не найдены</td></tr>'
+    return
+  }
+  tbody.innerHTML = customers.map(c => `
+    <tr onclick="openCustomer('${c.id}')">
+      <td><strong>${escHtml(c.name)}</strong></td>
+      <td class="mono" style="color:var(--muted)">${c.inn || '—'}</td>
+      <td>${c.email ? `<a href="mailto:${escHtml(c.email)}" onclick="event.stopPropagation()">${escHtml(c.email)}</a>` : '—'}</td>
+      <td>${c.phone || '—'}</td>
+      <td style="color:var(--muted)">${c._count?.orders ?? 0}</td>
+      <td><span class="badge ${PRIORITY_CLASSES[c.priority] || 'b-normal'}">${PRIORITY_LABELS[c.priority] || c.priority}</span></td>
+    </tr>`).join('')
+}
+
+function openCustomer(id) { window.location.href = `customer.html?id=${id}` }
+
+function onSearch() {
+  clearTimeout(searchTimer)
+  searchTimer = setTimeout(() => load(document.getElementById('searchInput').value), 300)
+}
+
+function openCreateModal() { document.getElementById('createModal').classList.remove('hidden') }
+function closeCreateModal() { document.getElementById('createModal').classList.add('hidden') }
+
+async function createCustomer() {
+  const body = {
+    name:     document.getElementById('fName').value.trim(),
+    inn:      document.getElementById('fInn').value.trim() || null,
+    email:    document.getElementById('fEmail').value.trim() || null,
+    phone:    document.getElementById('fPhone').value.trim() || null,
+    website:  document.getElementById('fWebsite').value.trim() || null,
+    priority: document.getElementById('fPriority').value,
+  }
+  if (!body.name) { alert('Введите название компании'); return }
+  const res = await fetch(`${API}/customers`, { method: 'POST', headers: { 'Content-Type': 'application/json', ...authHeaders() }, body: JSON.stringify(body) })
+  if (!res.ok) { alert('Ошибка при создании'); return }
+  closeCreateModal()
+  await load()
+  const created = await res.json()
+  window.location.href = `customer.html?id=${created.id}`
+}
+
+function authHeaders() {
+  const token = localStorage.getItem('erp_token')
+  return token ? { Authorization: `Bearer ${token}` } : {}
+}
+
+function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }
+
+load()
+</script>
+</body>
+</html>
