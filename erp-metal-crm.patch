+.email-detail{flex:1;overflow-y:auto;background:var(--bg);padding:20px;}
+.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:6px;border:none;cursor:pointer;font-family:'Manrope';font-size:12.5px;font-weight:600;transition:all .12s;white-space:nowrap;}
+.btn-primary{background:var(--accent);color:#fff;}.btn-primary:hover{background:var(--accent-h);}
+.btn-secondary{background:var(--bg);color:var(--text);border:1px solid var(--border2);}.btn-secondary:hover{border-color:var(--accent);color:var(--accent);}
+.btn-success{background:#f0fdf4;color:var(--green);border:1px solid #bbf7d0;}
+.btn-sm{padding:4px 10px;font-size:12px;}
+.filter-bar{padding:8px 12px;border-bottom:1px solid var(--border);display:flex;gap:6px;}
+.filter-btn{padding:3px 10px;border-radius:12px;border:1px solid var(--border2);background:var(--surface);color:var(--muted);font-family:'Manrope';font-size:11.5px;font-weight:600;cursor:pointer;}
+.filter-btn.active{background:var(--accent);border-color:var(--accent);color:#fff;}
+.email-item{padding:12px 14px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s;}
+.email-item:hover{background:#f8faff;}
+.email-item.selected{background:#eff6ff;border-left:3px solid var(--accent);}
+.email-item.unread .ei-subject{font-weight:700;}
+.ei-from{font-size:12.5px;font-weight:600;margin-bottom:2px;display:flex;justify-content:space-between;}
+.ei-subject{font-size:12px;color:var(--text);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
+.ei-meta{display:flex;gap:6px;align-items:center;}
+.badge{display:inline-flex;align-items:center;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;}
+.b-rfq{background:#eff6ff;color:var(--accent);}
+.b-order{background:#f0fdf4;color:var(--green);}
+.b-question{background:#f5f3ff;color:var(--purple);}
+.b-complaint{background:#fef2f2;color:var(--red);}
+.b-spam{background:#f9fafb;color:var(--muted);}
+.b-other{background:#f9fafb;color:var(--muted);}
+.b-critical{background:#fef2f2;color:var(--red);}
+.b-urgent{background:#fff7ed;color:var(--orange);}
+.b-normal{background:#f0fdf4;color:var(--green);}
+.b-low{background:#f9fafb;color:var(--muted);}
+.detail-empty{display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:14px;}
+.detail-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;margin-bottom:16px;overflow:hidden;}
+.detail-header{padding:14px 18px;border-bottom:1px solid var(--border);}
+.detail-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;}
+.detail-body{padding:18px;font-size:13px;line-height:1.7;white-space:pre-wrap;max-height:300px;overflow-y:auto;}
+.section-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);padding:12px 18px 8px;border-bottom:1px solid var(--border);}
+.summary-block{padding:14px 18px;background:#f8faff;border-bottom:1px solid var(--border);font-size:13px;line-height:1.6;color:var(--text);}
+.entity-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:14px 18px;}
+.entity-item{background:var(--bg);border-radius:6px;padding:8px 12px;}
+.entity-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:2px;}
+.entity-value{font-size:13px;font-weight:600;}
+.draft-list{padding:14px 18px;}
+.draft-item{border:2px solid var(--border);border-radius:8px;padding:14px;margin-bottom:10px;cursor:pointer;transition:all .12s;}
+.draft-item:hover,.draft-item.selected{border-color:var(--accent);background:#f8fbff;}
+.draft-strategy{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--accent);margin-bottom:6px;}
+.draft-body{font-size:12.5px;line-height:1.6;color:var(--text);white-space:pre-wrap;max-height:120px;overflow:hidden;}
+.reply-area{padding:14px 18px;}
+.reply-textarea{width:100%;min-height:140px;padding:12px;border:1px solid var(--border2);border-radius:6px;font-family:'Manrope';font-size:13px;resize:vertical;outline:none;line-height:1.6;}
+.reply-textarea:focus{border-color:var(--accent);}
+.reply-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
+.items-table{padding:0 18px 14px;}
+.items-table table{width:100%;border-collapse:collapse;font-size:12.5px;}
+.items-table th{padding:6px 8px;text-align:left;font-size:10.5px;font-weight:700;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);}
+.items-table td{padding:6px 8px;border-bottom:1px solid var(--border);}
+.hidden{display:none!important;}
+</style>
+</head>
+<body>
+<div class="shell">
+  <aside class="sidebar">
+    <div class="logo">МеталлПро ERP <span>Рабочий стенд v1.0</span></div>
+    <nav>
+      <div class="nav-group">Workflow</div>
+      <a class="nav-item" href="orders.html"><span>📋</span> Журнал заказов</a>
+      <a class="nav-item" href="simulator.html"><span>🧮</span> Расчёт КП</a>
+      <div class="nav-group">CRM</div>
+      <a class="nav-item" href="crm.html"><span>👥</span> Клиенты</a>
+      <a class="nav-item active" href="email-inbox.html"><span>📧</span> Входящие письма</a>
+      <div class="nav-group">Справочники</div>
+      <a class="nav-item" href="materials.html"><span>🔩</span> Материалы</a>
+      <a class="nav-item" href="templates.html"><span>📦</span> Шаблоны</a>
+    </nav>
+    <div class="sidebar-bottom">МеталлПро ERP · v1.0</div>
+  </aside>
+
+  <div class="main">
+    <div class="topbar">
+      <div class="topbar-title">Email Copilot</div>
+      <div class="topbar-right">
+        <span id="pollStatus" style="font-size:12px;color:var(--muted)">Последнее обновление: —</span>
+        <button class="btn btn-secondary btn-sm" onclick="triggerPoll()">⟳ Проверить почту</button>
+      </div>
+    </div>
+
+    <div class="email-shell">
+      <!-- Left: message list -->
+      <div class="email-list">
+        <div class="filter-bar">
+          <button class="filter-btn active" onclick="setFilter('pending')" id="f-pending">Новые</button>
+          <button class="filter-btn" onclick="setFilter('')" id="f-all">Все</button>
+          <button class="filter-btn" onclick="setFilter('rfq')" id="f-rfq">RFQ</button>
+        </div>
+        <div id="messageList"></div>
+      </div>
+
+      <!-- Right: detail -->
+      <div class="email-detail" id="emailDetail">
+        <div class="detail-empty">Выберите письмо из списка</div>
+      </div>
+    </div>
+  </div>
+</div>
+
+<script>
+const AI_API = (window.AI_API_URL || 'http://localhost:4000') + '/api/email-copilot'
+const ERP_API = '/api'
+let messages = []
+let selectedId = null
+let currentFilter = 'pending'
+let selectedDraftIdx = null
+
+const INTENT_LABELS = { RFQ:'КП', ORDER:'Заказ', QUESTION:'Вопрос', COMPLAINT:'Жалоба', CLARIFICATION:'Уточнение', SPAM:'Спам', OTHER:'Другое' }
+const INTENT_CLASSES = { RFQ:'b-rfq', ORDER:'b-order', QUESTION:'b-question', COMPLAINT:'b-complaint', SPAM:'b-spam', OTHER:'b-other' }
+const PRIO_CLASSES   = { critical:'b-critical', urgent:'b-urgent', normal:'b-normal', low:'b-low' }
+
+async function loadMessages() {
+  const q = currentFilter === 'rfq' ? `?intent=RFQ` : currentFilter === 'pending' ? `?status=pending` : ''
+  try {
+    const res = await fetch(`${AI_API}/inbox${q}`)
+    if (!res.ok) { showListError(); return }
+    const data = await res.json()
+    messages = data.messages || []
+    renderList()
+  } catch { showListError() }
+}
+
+function showListError() {
+  document.getElementById('messageList').innerHTML = `<div style="padding:20px;text-align:center;color:var(--muted)">Нет связи с AI-сервисом.<br><small>Проверьте что metalpro-ai-polygon запущен.</small></div>`
+}
+
+function renderList() {
+  const el = document.getElementById('messageList')
+  if (!messages.length) { el.innerHTML = `<div style="padding:20px;text-align:center;color:var(--muted)">Нет писем</div>`; return }
+  el.innerHTML = messages.map(m => `
+    <div class="email-item ${m.status==='pending'?'unread':''} ${m.id===selectedId?'selected':''}" onclick="selectMessage('${m.id}')">
+      <div class="ei-from">
+        <span>${escHtml(extractName(m.fromAddress))}</span>
+        <span style="font-size:10.5px;color:var(--muted);font-weight:400">${fmtTime(m.receivedAt)}</span>
+      </div>
+      <div class="ei-subject">${escHtml(m.subject||'(без темы)')}</div>
+      <div class="ei-meta">
+        ${m.aiIntent ? `<span class="badge ${INTENT_CLASSES[m.aiIntent]||'b-other'}">${INTENT_LABELS[m.aiIntent]||m.aiIntent}</span>` : ''}
+        ${m.aiPriority ? `<span class="badge ${PRIO_CLASSES[m.aiPriority]||'b-normal'}">${m.aiPriority}</span>` : ''}
+      </div>
+    </div>`).join('')
+}
+
+function selectMessage(id) {
+  selectedId = id
+  selectedDraftIdx = null
+  renderList()
+  const msg = messages.find(m => m.id === id)
+  if (!msg) return
+  renderDetail(msg)
+}
+
+function renderDetail(msg) {
+  const drafts = (msg.aiDrafts || [])
+  const extracted = msg.aiExtracted || {}
+  const items = extracted.items || []
+
+  document.getElementById('emailDetail').innerHTML = `
+    <div class="detail-card">
+      <div class="detail-header">
+        <div style="font-weight:700;font-size:14px;margin-bottom:4px">${escHtml(msg.subject||'(без темы)')}</div>
+        <div style="font-size:12.5px;color:var(--muted)">От: ${escHtml(msg.fromAddress)} · ${fmtDate(msg.receivedAt)}</div>
+        <div class="detail-meta">
+          ${msg.aiIntent ? `<span class="badge ${INTENT_CLASSES[msg.aiIntent]||'b-other'}">${INTENT_LABELS[msg.aiIntent]||msg.aiIntent}</span>` : ''}
+          ${msg.aiPriority ? `<span class="badge ${PRIO_CLASSES[msg.aiPriority]||'b-normal'}">${msg.aiPriority}</span>` : ''}
+          ${msg.aiConfidence ? `<span style="font-size:11px;color:var(--muted)">уверенность ${Math.round(msg.aiConfidence*100)}%</span>` : ''}
+          ${msg.aiModelUsed ? `<span style="font-size:11px;color:var(--muted)">via ${msg.aiModelUsed}</span>` : ''}
+        </div>
+      </div>
+      ${msg.aiSummary ? `<div class="summary-block">💡 ${escHtml(msg.aiSummary)}</div>` : ''}
+      <div class="detail-body">${escHtml(msg.bodyText||'')}</div>
+    </div>
+
+    ${items.length ? `
+    <div class="detail-card">
+      <div class="section-title">Извлечённые позиции</div>
+      <div class="items-table">
+        <table>
+          <thead><tr><th>Наименование</th><th>Кол-во</th><th>Ед.</th><th>Материал</th></tr></thead>
+          <tbody>${items.map(it=>`<tr><td>${escHtml(it.name||'')}</td><td>${it.quantity||'—'}</td><td>${it.unit||'—'}</td><td>${it.material||'—'}</td></tr>`).join('')}</tbody>
+        </table>
+      </div>
+    </div>` : ''}
+
+    ${extracted.company||extracted.contact||extracted.deadline ? `
+    <div class="detail-card">
+      <div class="section-title">Извлечённые данные</div>
+      <div class="entity-grid">
+        ${extracted.company  ? `<div class="entity-item"><div class="entity-label">Компания</div><div class="entity-value">${escHtml(extracted.company)}</div></div>` : ''}
+        ${extracted.contact  ? `<div class="entity-item"><div class="entity-label">Контакт</div><div class="entity-value">${escHtml(extracted.contact)}</div></div>` : ''}
+        ${extracted.deadline ? `<div class="entity-item"><div class="entity-label">Срок</div><div class="entity-value">${escHtml(extracted.deadline)}</div></div>` : ''}
+        ${extracted.currency ? `<div class="entity-item"><div class="entity-label">Валюта</div><div class="entity-value">${escHtml(extracted.currency)}</div></div>` : ''}
+      </div>
+    </div>` : ''}
+
+    ${drafts.length ? `
+    <div class="detail-card">
+      <div class="section-title">Варианты ответа — выберите один</div>
+      <div class="draft-list">
+        ${drafts.map((d,i)=>`
+          <div class="draft-item" id="draft-${i}" onclick="selectDraft(${i}, ${JSON.stringify(d.body).replace(/</g,'\\u003c')})">
+            <div class="draft-strategy">${escHtml(d.strategy||`Вариант ${i+1}`)}</div>
+            <div class="draft-body">${escHtml(d.body||'')}</div>
+          </div>`).join('')}
+      </div>
+    </div>` : ''}
+
+    <div class="detail-card">
+      <div class="section-title">Ответ</div>
+      <div class="reply-area">
+        <textarea class="reply-textarea" id="replyText" placeholder="Выберите вариант выше или напишите ответ вручную..."></textarea>
+        <div class="reply-actions">
+          <button class="btn btn-primary" onclick="sendReply('${msg.messageId}','${msg.fromAddress}')">Отправить</button>
+          ${msg.aiSuggestRfq !== false ? `<button class="btn btn-success" onclick="openRfqModal('${msg.messageId}','${escHtml(extracted.company||msg.fromAddress)}')">+ Заявка на КП</button>` : ''}
+          <button class="btn btn-secondary btn-sm" onclick="archiveMsg('${msg.id}')">В архив</button>
+        </div>
+      </div>
+    </div>`
+
+  return ''
+}
+
+function selectDraft(idx, body) {
+  selectedDraftIdx = idx
+  document.querySelectorAll('.draft-item').forEach((el, i) => el.classList.toggle('selected', i === idx))
+  document.getElementById('replyText').value = body
+}
+
+async function sendReply(messageId, fromAddress) {
+  const body = document.getElementById('replyText').value.trim()
+  if (!body) { alert('Введите текст ответа'); return }
+  const res = await fetch(`${AI_API}/reply`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ messageId, replyBody: body, sentBy: 'manager' }),
+  })
+  if (!res.ok) { alert('Ошибка отправки'); return }
+  alert('Ответ отправлен!')
+  await loadMessages()
+  document.getElementById('emailDetail').innerHTML = '<div class="detail-empty">Выберите письмо из списка</div>'
+}
+
+async function archiveMsg(id) {
+  await fetch(`${AI_API}/archive/${id}`, { method: 'POST' })
+  await loadMessages()
+  document.getElementById('emailDetail').innerHTML = '<div class="detail-empty">Выберите письмо из списка</div>'
+}
+
+let rfqCtx = {}
+function openRfqModal(messageId, customerName) {
+  rfqCtx = { messageId, customerName }
+  const title = prompt(`Создать заявку на КП для "${customerName}".\nВведите название объекта:`)
+  if (!title) return
+  createRfq(title)
+}
+
+async function createRfq(title) {
+  const res = await fetch(`${AI_API}/create-rfq`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ messageId: rfqCtx.messageId, customerName: rfqCtx.customerName, title }),
+  })
+  if (!res.ok) { alert('Ошибка создания заявки'); return }
+  const data = await res.json()
+  if (confirm(`Заявка ${data.orderNumber} создана! Открыть расчёт КП?`)) {
+    window.location.href = `simulator.html?orderId=${data.orderId}`
+  }
+}
+
+async function triggerPoll() {
+  document.getElementById('pollStatus').textContent = 'Проверяю...'
+  try {
+    const res = await fetch(`${AI_API}/poll`, { method: 'POST' })
+    const data = await res.json()
+    document.getElementById('pollStatus').textContent = `Получено: ${data.processed} новых · ${fmtTime(new Date())}`
+    await loadMessages()
+  } catch {
+    document.getElementById('pollStatus').textContent = 'Ошибка подключения'
+  }
+}
+
+function setFilter(f) {
+  currentFilter = f
+  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'))
+  document.getElementById(f === '' ? 'f-all' : f === 'rfq' ? 'f-rfq' : 'f-pending').classList.add('active')
+  loadMessages()
+}
+
+function extractName(addr) { const m = addr.match(/^(.+?)\s*</) ; return m ? m[1].trim() : addr.split('@')[0] }
+function escHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }
+function fmtDate(d) { return d ? new Date(d).toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '' }
+function fmtTime(d) { return d ? new Date(d).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'}) : '' }
+
+loadMessages()
+</script>
+</body>
+</html>
