+.logo{padding:14px 16px;border-bottom:1px solid var(--border);font-weight:800;font-size:14px;color:var(--accent);}
+.logo span{display:block;font-size:10px;font-weight:500;color:var(--muted);margin-top:2px;}
+nav{padding:8px;flex:1;}
+.nav-group{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted);padding:10px 8px 4px;}
+.nav-item{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:6px;cursor:pointer;color:var(--muted);font-weight:500;font-size:12.5px;transition:all .1s;margin-bottom:1px;text-decoration:none;}
+.nav-item:hover{background:var(--bg);color:var(--text);}
+.nav-item.active{background:#eff6ff;color:var(--accent);font-weight:600;}
+.sidebar-bottom{padding:12px;border-top:1px solid var(--border);font-size:11px;color:var(--muted);}
+.main{margin-left:204px;flex:1;}
+.topbar{height:48px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 20px;gap:12px;position:sticky;top:0;z-index:20;}
+.topbar-title{font-weight:700;font-size:14px;}
+.topbar-right{margin-left:auto;display:flex;gap:8px;align-items:center;}
+.content{padding:20px;display:grid;grid-template-columns:320px 1fr;gap:16px;align-items:start;}
+.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:6px;border:none;cursor:pointer;font-family:'Manrope';font-size:12.5px;font-weight:600;transition:all .12s;white-space:nowrap;}
+.btn-primary{background:var(--accent);color:#fff;}.btn-primary:hover{background:var(--accent-h);}
+.btn-secondary{background:var(--bg);color:var(--text);border:1px solid var(--border2);}.btn-secondary:hover{border-color:var(--accent);color:var(--accent);}
+.btn-success{background:#f0fdf4;color:var(--green);border:1px solid #bbf7d0;}.btn-success:hover{background:#dcfce7;}
+.btn-sm{padding:4px 10px;font-size:12px;}
+.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:12px;}
+.card-header{padding:12px 16px;border-bottom:1px solid var(--border);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);display:flex;justify-content:space-between;align-items:center;}
+.card-body{padding:16px;}
+.info-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:12.5px;}
+.info-row:last-child{border-bottom:none;}
+.info-label{color:var(--muted);font-weight:500;}
+.info-value{font-weight:600;text-align:right;}
+.badge{display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;}
+.b-vip{background:#fdf4ff;color:var(--purple);}
+.b-high{background:#eff6ff;color:var(--accent);}
+.b-normal{background:#f0fdf4;color:var(--green);}
+.b-draft{background:#f8fafc;color:var(--muted);}
+.b-quotation{background:#eff6ff;color:var(--accent);}
+.b-approved{background:#f0fdf4;color:var(--green);}
+.b-production{background:#fff7ed;color:var(--orange);}
+.tab-bar{display:flex;border-bottom:1px solid var(--border);padding:0 16px;}
+.tab{padding:10px 16px;font-size:12.5px;font-weight:600;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;}
+.tab.active{color:var(--accent);border-bottom-color:var(--accent);}
+.tab-content{padding:16px;display:none;}
+.tab-content.active{display:block;}
+table{width:100%;border-collapse:collapse;}
+thead th{padding:7px 10px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);background:#fafbfc;border-bottom:1px solid var(--border);}
+tbody tr{border-bottom:1px solid var(--border);}
+tbody tr:last-child{border-bottom:none;}
+td{padding:8px 10px;vertical-align:middle;font-size:12.5px;}
+.interaction-item{padding:10px 0;border-bottom:1px solid var(--border);}
+.interaction-item:last-child{border-bottom:none;}
+.int-header{display:flex;gap:8px;align-items:center;margin-bottom:4px;}
+.int-dir{font-size:10px;padding:1px 6px;border-radius:3px;font-weight:700;}
+.int-in{background:#f0fdf4;color:var(--green);}
+.int-out{background:#eff6ff;color:var(--accent);}
+.int-time{font-size:11px;color:var(--muted);margin-left:auto;}
+.int-subject{font-weight:600;font-size:12.5px;}
+.int-body{font-size:12px;color:var(--muted);margin-top:2px;white-space:pre-wrap;max-height:60px;overflow:hidden;}
+.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:100;display:flex;align-items:center;justify-content:center;padding:20px;}
+.modal{background:var(--surface);border-radius:10px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,.2);}
+.modal-header{padding:16px 20px;border-bottom:1px solid var(--border);font-weight:700;font-size:14px;display:flex;justify-content:space-between;align-items:center;}
+.modal-body{padding:20px;}
+.modal-footer{padding:12px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;}
+.form-group{margin-bottom:14px;}
+.form-label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:4px;}
+.form-input{width:100%;height:34px;padding:0 10px;border:1px solid var(--border2);border-radius:5px;font-family:'Manrope';font-size:13px;color:var(--text);outline:none;background:var(--surface);}
+.form-input:focus{border-color:var(--accent);}
+.form-textarea{width:100%;padding:8px 10px;border:1px solid var(--border2);border-radius:5px;font-family:'Manrope';font-size:13px;color:var(--text);outline:none;background:var(--surface);resize:vertical;min-height:80px;}
+.form-textarea:focus{border-color:var(--accent);}
+.form-select{width:100%;height:34px;padding:0 10px;border:1px solid var(--border2);border-radius:5px;font-family:'Manrope';font-size:13px;background:var(--surface);}
+.hidden{display:none!important;}
+</style>
+</head>
+<body>
+<div class="shell">
+  <aside class="sidebar">
+    <div class="logo">МеталлПро ERP <span>Рабочий стенд v1.0</span></div>
+    <nav>
+      <div class="nav-group">Workflow</div>
+      <a class="nav-item" href="orders.html"><span>📋</span> Журнал заказов</a>
+      <a class="nav-item" href="simulator.html"><span>🧮</span> Расчёт КП</a>
+      <div class="nav-group">CRM</div>
+      <a class="nav-item active" href="crm.html"><span>👥</span> Клиенты</a>
+      <a class="nav-item" href="email-inbox.html"><span>📧</span> Входящие письма</a>
+      <div class="nav-group">Справочники</div>
+      <a class="nav-item" href="materials.html"><span>🔩</span> Материалы</a>
+      <a class="nav-item" href="templates.html"><span>📦</span> Шаблоны</a>
+    </nav>
+    <div class="sidebar-bottom">МеталлПро ERP · v1.0</div>
+  </aside>
+
+  <div class="main">
+    <div class="topbar">
+      <a href="crm.html" class="btn btn-secondary btn-sm">← Назад</a>
+      <div class="topbar-title" id="topbarTitle">Загрузка...</div>
+      <div class="topbar-right">
+        <button class="btn btn-success" onclick="createRfq()">+ Заявка на КП</button>
+        <button class="btn btn-secondary" onclick="openAddContact()">+ Контакт</button>
+      </div>
+    </div>
+
+    <div class="content" id="mainContent">
+      <div>
+        <!-- Info card -->
+        <div class="card">
+          <div class="card-header">Карточка клиента</div>
+          <div class="card-body" id="customerInfo">Загрузка...</div>
+        </div>
+        <!-- Contacts -->
+        <div class="card">
+          <div class="card-header">Контакты <button class="btn btn-sm btn-secondary" onclick="openAddContact()">+</button></div>
+          <div class="card-body" id="contactsList">—</div>
+        </div>
+      </div>
+
+      <!-- Tabs: Orders + History -->
+      <div class="card">
+        <div class="tab-bar">
+          <div class="tab active" onclick="showTab('orders')">Заказы</div>
+          <div class="tab" onclick="showTab('history')">История взаимодействий</div>
+        </div>
+        <div class="tab-content active" id="tab-orders">
+          <table id="ordersTable">
+            <thead><tr><th>Номер</th><th>Объект</th><th>Статус</th><th>Дата</th></tr></thead>
+            <tbody id="ordersBody"><tr><td colspan="4" style="text-align:center;padding:20px;color:var(--muted)">Загрузка...</td></tr></tbody>
+          </table>
+        </div>
+        <div class="tab-content" id="tab-history">
+          <div id="historyList" style="padding:0">Загрузка...</div>
+        </div>
+      </div>
+    </div>
+  </div>
+</div>
+
+<!-- Add Contact modal -->
+<div class="modal-bg hidden" id="contactModal">
+  <div class="modal">
+    <div class="modal-header">Добавить контакт <button class="btn btn-sm btn-secondary" onclick="closeContactModal()">✕</button></div>
+    <div class="modal-body">
+      <div class="form-group"><label class="form-label">Имя *</label><input class="form-input" id="cName"></div>
+      <div class="form-group"><label class="form-label">Должность</label><input class="form-input" id="cPosition"></div>
+      <div class="form-group"><label class="form-label">Email</label><input class="form-input" id="cEmail" type="email"></div>
+      <div class="form-group"><label class="form-label">Телефон</label><input class="form-input" id="cPhone"></div>
+    </div>
+    <div class="modal-footer">
+      <button class="btn btn-secondary" onclick="closeContactModal()">Отмена</button>
+      <button class="btn btn-primary" onclick="saveContact()">Сохранить</button>
+    </div>
+  </div>
+</div>
+
+<!-- Create RFQ modal -->
+<div class="modal-bg hidden" id="rfqModal">
+  <div class="modal">
+    <div class="modal-header">Заявка на расчёт КП <button class="btn btn-sm btn-secondary" onclick="closeRfqModal()">✕</button></div>
+    <div class="modal-body">
+      <div class="form-group"><label class="form-label">Объект / название заявки *</label><input class="form-input" id="rfqTitle" placeholder="Металлоконструкции цеха №3"></div>
+      <div class="form-group"><label class="form-label">Примечание</label><textarea class="form-textarea" id="rfqNotes"></textarea></div>
+    </div>
+    <div class="modal-footer">
+      <button class="btn btn-secondary" onclick="closeRfqModal()">Отмена</button>
+      <button class="btn btn-success" onclick="submitRfq()">Создать заявку</button>
+    </div>
+  </div>
+</div>
+
+<script>
+const API = '/api'
+const params = new URLSearchParams(location.search)
+const customerId = params.get('id')
+let customer = null
+
+const STATUS_LABELS = { DRAFT:'Черновик', QUOTATION:'КП', AWAITING_APPROVAL:'На согласовании', APPROVED:'Утверждён', PRODUCTION:'В производстве', COMPLETED:'Завершён', DELIVERED:'Отгружен', CANCELLED:'Отменён' }
+const STATUS_CLASSES = { DRAFT:'b-draft', QUOTATION:'b-quotation', APPROVED:'b-approved', PRODUCTION:'b-production' }
+const PRIORITY_LABELS = { VIP:'VIP', HIGH:'Высокий', NORMAL:'Обычный', LOW:'Низкий' }
+const PRIORITY_CLASSES = { VIP:'b-vip', HIGH:'b-high', NORMAL:'b-normal', LOW:'b-draft' }
+
+if (!customerId) { window.location.href = 'crm.html' }
+
+async function load() {
+  const res = await fetch(`${API}/customers/${customerId}`, { headers: authHeaders() })
+  if (!res.ok) { window.location.href = 'crm.html'; return }
+  customer = await res.json()
+  renderCustomer()
+  renderContacts()
+  renderOrders()
+  renderHistory()
+}
+
+function renderCustomer() {
+  document.getElementById('topbarTitle').textContent = customer.name
+  document.getElementById('customerInfo').innerHTML = `
+    <div class="info-row"><span class="info-label">Компания</span><span class="info-value">${escHtml(customer.name)}</span></div>
+    ${customer.inn ? `<div class="info-row"><span class="info-label">ИНН</span><span class="info-value mono">${customer.inn}</span></div>` : ''}
+    ${customer.email ? `<div class="info-row"><span class="info-label">Email</span><span class="info-value"><a href="mailto:${escHtml(customer.email)}">${escHtml(customer.email)}</a></span></div>` : ''}
+    ${customer.phone ? `<div class="info-row"><span class="info-label">Телефон</span><span class="info-value">${customer.phone}</span></div>` : ''}
+    ${customer.website ? `<div class="info-row"><span class="info-label">Сайт</span><span class="info-value"><a href="${escHtml(customer.website)}" target="_blank">${escHtml(customer.website)}</a></span></div>` : ''}
+    <div class="info-row"><span class="info-label">Приоритет</span><span class="info-value"><span class="badge ${PRIORITY_CLASSES[customer.priority]||'b-normal'}">${PRIORITY_LABELS[customer.priority]||customer.priority}</span></span></div>
+  `
+}
+
+function renderContacts() {
+  const el = document.getElementById('contactsList')
+  if (!customer.contacts?.length) { el.innerHTML = '<div style="color:var(--muted);font-size:12px">Контакты не добавлены</div>'; return }
+  el.innerHTML = customer.contacts.map(c => `
+    <div style="padding:8px 0;border-bottom:1px solid var(--border)">
+      <div style="font-weight:600">${escHtml(c.name)}${c.position ? ` <span style="color:var(--muted);font-weight:400">— ${escHtml(c.position)}</span>` : ''}</div>
+      <div style="font-size:12px;color:var(--muted);margin-top:2px">${[c.email,c.phone].filter(Boolean).join(' · ') || '—'}</div>
+    </div>`).join('')
+}
+
+function renderOrders() {
+  const tbody = document.getElementById('ordersBody')
+  if (!customer.orders?.length) { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--muted)">Заказов нет</td></tr>'; return }
+  tbody.innerHTML = customer.orders.map(o => `
+    <tr style="cursor:pointer" onclick="window.location.href='orders.html#${o.id}'">
+      <td class="mono">${escHtml(o.orderNumber)}</td>
+      <td>${escHtml(o.title)}</td>
+      <td><span class="badge ${STATUS_CLASSES[o.status]||'b-draft'}">${STATUS_LABELS[o.status]||o.status}</span></td>
+      <td style="color:var(--muted)">${fmtDate(o.createdAt)}</td>
+    </tr>`).join('')
+}
+
+function renderHistory() {
+  const el = document.getElementById('historyList')
+  if (!customer.interactions?.length) { el.innerHTML = '<div style="padding:16px;color:var(--muted)">История пуста</div>'; return }
+  el.innerHTML = customer.interactions.map(i => `
+    <div class="interaction-item" style="padding:10px 16px">
+      <div class="int-header">
+        <span style="font-size:11px;font-weight:700;color:var(--muted)">${i.type}</span>
+        <span class="int-dir ${i.direction==='INBOUND'?'int-in':'int-out'}">${i.direction==='INBOUND'?'← входящее':'→ исходящее'}</span>
+        ${i.order ? `<span style="font-size:11px;color:var(--accent)">Заказ ${escHtml(i.order.orderNumber)}</span>` : ''}
+        <span class="int-time">${fmtDate(i.createdAt)}</span>
+      </div>
+      ${i.subject ? `<div class="int-subject">${escHtml(i.subject)}</div>` : ''}
+      ${i.body ? `<div class="int-body">${escHtml(i.body)}</div>` : ''}
+    </div>`).join('')
+}
+
+function showTab(name) {
+  document.querySelectorAll('.tab').forEach((t,i) => t.classList.toggle('active', ['orders','history'][i]===name))
+  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'))
+  document.getElementById(`tab-${name}`).classList.add('active')
+}
+
+function openAddContact() { document.getElementById('contactModal').classList.remove('hidden') }
+function closeContactModal() { document.getElementById('contactModal').classList.add('hidden') }
+
+async function saveContact() {
+  const body = { name: document.getElementById('cName').value.trim(), position: document.getElementById('cPosition').value.trim()||null, email: document.getElementById('cEmail').value.trim()||null, phone: document.getElementById('cPhone').value.trim()||null }
+  if (!body.name) { alert('Введите имя'); return }
+  const res = await fetch(`${API}/customers/${customerId}/contacts`, { method:'POST', headers:{'Content-Type':'application/json',...authHeaders()}, body:JSON.stringify(body) })
+  if (!res.ok) { alert('Ошибка'); return }
+  closeContactModal()
+  await load()
+}
+
+function createRfq() { document.getElementById('rfqModal').classList.remove('hidden') }
+function closeRfqModal() { document.getElementById('rfqModal').classList.add('hidden') }
+
+async function submitRfq() {
+  const title = document.getElementById('rfqTitle').value.trim()
+  if (!title) { alert('Введите название заявки'); return }
+  const body = { orderNumber: `RFQ-${Date.now()}`, customerName: customer.name, customerId, title, description: document.getElementById('rfqNotes').value.trim()||null }
+  const res = await fetch(`${API}/orders`, { method:'POST', headers:{'Content-Type':'application/json',...authHeaders()}, body:JSON.stringify(body) })
+  if (!res.ok) { alert('Ошибка создания заявки'); return }
+  const order = await res.json()
+  closeRfqModal()
+  window.location.href = `simulator.html?orderId=${order.id}`
+}
+
+function authHeaders() { const t=localStorage.getItem('erp_token'); return t?{Authorization:`Bearer ${t}`}:{} }
+function escHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }
+function fmtDate(d) { return d ? new Date(d).toLocaleDateString('ru-RU',{day:'2-digit',month:'2-digit',year:'numeric'}) : '—' }
+
+load()
+</script>
+</body>
+</html>
